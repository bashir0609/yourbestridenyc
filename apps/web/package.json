{
  "name": "@yourbestride/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --conditions=react-server --test tests/*.test.ts tests/cms/*.test.ts",
    "test:smoke": "node tests/smoke.mjs",
    "seed": "tsx src/seed/cli.ts",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "catalog:",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@yourbestride/ui": "workspace:*",
    "@yourbestride/types": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "framer-motion": "^12.23.0",
    "graphql": "16.11.0",
    "payload": "3.90.2",
    "sharp": "0.35.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "tailwindcss": "catalog:",
    "@types/node": "^22.15.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "eslint": "^9.25.0",
    "eslint-config-next": "catalog:",
    "@yourbestride/config": "workspace:*",
    "tsx": "^4.20.0"
  }
}
