    "react": "catalog:",
    "react-dom": "catalog:",
    "framer-motion": "^12.23.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "tailwindcss": "catalog:",
    "@types/node": "^22.15.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "eslint": "^9.25.0",
    "eslint-config-next": "catalog:",
    "@yourbestride/config": "workspace:*",
    "tsx": "^4.20.0"
  }
