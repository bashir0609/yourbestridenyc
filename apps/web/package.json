{
  "name": "@yourbestride/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:smoke": "node tests/smoke.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
