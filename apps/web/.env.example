# Server-side public configuration only. No CMS/R2/database credentials here.
SITE_URL=
# Local development: http://localhost:3001; production: actual CMS HTTPS origin
CMS_URL=
# Same public origin as CMS S3_PUBLIC_URL, e.g. your R2 custom media domain.
# Only HTTPS images under /media/ are allowed. Rebuild after changing this value.
CMS_MEDIA_URL=
# Optional business-approved overrides for CMS Site Settings
LIMO_ANYWHERE_BOOKING_URL=
CONTACT_EMAIL=
CONTACT_PHONE=
# Independent random secret (32+ characters) for optional publishing webhooks
REVALIDATION_SECRET=
