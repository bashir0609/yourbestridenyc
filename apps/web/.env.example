# Single-deployment application origin
SITE_URL=http://localhost:3000

# Payload CMS and Neon PostgreSQL (server-only)
PAYLOAD_SECRET=
DATABASE_URI=
DATABASE_PUSH=false
CMS_ALLOW_FIRST_USER=false
CMS_CORS_ORIGINS=

# Internal public-intake authentication and abuse controls (server-only)
INTAKE_API_SECRET=
INTAKE_HASH_SECRET=

# Cloudflare R2 public marketing media (server-only credentials)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_URL=

# Public media origin used by the Next.js image allowlist
CMS_MEDIA_URL=

# Resend notifications (server-only)
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=

# Public analytics identifier
NEXT_PUBLIC_GA_ID=

# Limo Anywhere booking handoff
LIMO_ANYWHERE_BOOKING_URL=

# Optional public contact overrides
CONTACT_EMAIL=
CONTACT_PHONE=

# Server-only cache invalidation secret
REVALIDATION_SECRET=

# Optional defense-in-depth allowlist for /admin (comma-separated exact IPs)
# Leave empty to rely on Payload authentication and Vercel Firewall rules.
ADMIN_ALLOWED_IPS=
