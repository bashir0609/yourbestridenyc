# Copy to apps/cms/.env for local use. Do not commit real credentials.
PAYLOAD_SECRET=
DATABASE_URI=

# Cloudflare R2 — public marketing bucket only
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
# Public media HTTPS origin; not the authenticated R2 endpoint.
S3_PUBLIC_URL=

# CMS URL — local dev: http://localhost:3001; production: actual HTTPS origin
CMS_URL=
CMS_CORS_ORIGINS=http://localhost:3000
DATABASE_PUSH=false
CMS_ALLOW_FIRST_USER=false

# Application records remain private in PostgreSQL. Do not upload private
# documents to Media; future private files need a separate private R2 bucket.
